WITH
    raw_team_stats AS (
        SELECT
            m_1.season_year,
            m_1.week,
            m_1.league_id,
            m_1.home_manager_id AS manager_id,
            m_1.home_score AS actual_fpts,
            m_1.home_projected AS proj_fpts,
            m_1.away_score AS opp_fpts,
            m_1.home_score - m_1.away_score AS margin,
            CASE
                WHEN m_1.home_score > m_1.away_score THEN 1
                ELSE 0
            END AS is_winner,
            dpr.wk_opt_fpts
        FROM
            vffl.matchups m_1
            LEFT JOIN vffl.division_power_rankings dpr ON m_1.home_manager_id = dpr.manager_id
            AND m_1.league_id = dpr.league_id
            AND m_1.season_year = dpr.season_year
            AND m_1.week = dpr.week
        WHERE
            (m_1.home_score IS NOT NULL OR m_1.home_projected IS NOT NULL)
            AND m_1.home_manager_id IS NOT NULL
        UNION ALL
        SELECT
            m_1.season_year,
            m_1.week,
            m_1.league_id,
            m_1.away_manager_id AS manager_id,
            m_1.away_score AS actual_fpts,
            m_1.away_projected AS proj_fpts,
            m_1.home_score AS opp_fpts,
            m_1.away_score - m_1.home_score AS margin,
            CASE
                WHEN m_1.away_score > m_1.home_score THEN 1
                ELSE 0
            END AS is_winner,
            dpr.wk_opt_fpts
        FROM
            vffl.matchups m_1
            LEFT JOIN vffl.division_power_rankings dpr ON m_1.away_manager_id = dpr.manager_id
            AND m_1.league_id = dpr.league_id
            AND m_1.season_year = dpr.season_year
            AND m_1.week = dpr.week
        WHERE
            (m_1.away_score IS NOT NULL OR m_1.away_projected IS NOT NULL)
            AND m_1.away_manager_id IS NOT NULL
    ),
    team_stats AS (
        SELECT
            raw_team_stats.*,
            max(COALESCE(raw_team_stats.actual_fpts, 0::real)) OVER (
                PARTITION BY
                    raw_team_stats.league_id,
                    raw_team_stats.season_year,
                    raw_team_stats.week
            ) > 0::real AS has_actual_points
        FROM
            raw_team_stats
    ),
    team_awards AS (
        SELECT
            team_stats.season_year,
            team_stats.week,
            team_stats.league_id,
            team_stats.manager_id,
            team_stats.actual_fpts,
            team_stats.proj_fpts,
            team_stats.opp_fpts,
            team_stats.margin,
            team_stats.is_winner,
            team_stats.wk_opt_fpts,
            team_stats.has_actual_points,
            row_number() OVER (
                PARTITION BY
                    team_stats.league_id,
                    team_stats.season_year,
                    team_stats.week
                ORDER BY
                    (
                        CASE
                            WHEN team_stats.has_actual_points THEN COALESCE(team_stats.actual_fpts, 0::real)
                            ELSE COALESCE(team_stats.proj_fpts, 0::real)
                        END
                    ) DESC,
                    COALESCE(team_stats.proj_fpts, 0::real) DESC
            ) AS rn_head_of_table,
            row_number() OVER (
                PARTITION BY
                    team_stats.league_id,
                    team_stats.season_year,
                    team_stats.week
                ORDER BY
                    (team_stats.actual_fpts - team_stats.proj_fpts) DESC NULLS LAST
            ) AS rn_overachiever,
            row_number() OVER (
                PARTITION BY
                    team_stats.league_id,
                    team_stats.season_year,
                    team_stats.week
                ORDER BY
                    team_stats.margin DESC NULLS LAST
            ) AS rn_body_bag,
            row_number() OVER (
                PARTITION BY
                    team_stats.league_id,
                    team_stats.season_year,
                    team_stats.week
                ORDER BY
                    (
                        CASE
                            WHEN team_stats.is_winner = 0 AND team_stats.actual_fpts IS NOT NULL THEN team_stats.actual_fpts
                            ELSE '-999'::real
                        END
                    ) DESC
            ) AS rn_tough_luck,
            row_number() OVER (
                PARTITION BY
                    team_stats.league_id,
                    team_stats.season_year,
                    team_stats.week
                ORDER BY
                    (
                        CASE
                            WHEN team_stats.is_winner = 1 AND team_stats.margin IS NOT NULL THEN team_stats.margin
                            ELSE 999::real
                        END
                    )
            ) AS rn_heartbreak_kid,
            row_number() OVER (
                PARTITION BY
                    team_stats.league_id,
                    team_stats.season_year,
                    team_stats.week
                ORDER BY
                    (
                        CASE
                            WHEN team_stats.is_winner = 1 AND team_stats.actual_fpts IS NOT NULL THEN team_stats.actual_fpts
                            ELSE 999::real
                        END
                    )
            ) AS rn_any_given_sunday,
            row_number() OVER (
                PARTITION BY
                    team_stats.league_id,
                    team_stats.season_year,
                    team_stats.week
                ORDER BY
                    (
                        team_stats.actual_fpts / NULLIF(team_stats.wk_opt_fpts, 0)
                    ) DESC NULLS LAST
            ) AS rn_armchair_architect
        FROM
            team_stats
    ),
    raw_player_stats AS (
        SELECT
            m_1.season_year,
            m_1.week,
            m_1.league_id,
            mr.manager_id,
            mr.player_id,
            mr.slot_position,
            mr.actual_fpts,
            mr.proj_fpts,
            max(COALESCE(mr.actual_fpts, 0::real)) OVER (
                PARTITION BY
                    m_1.league_id,
                    m_1.season_year,
                    m_1.week
            ) > 0::real AS has_actual_points,
            max(
                CASE
                    WHEN mr.slot_position = 'D/ST' THEN COALESCE(mr.actual_fpts, 0::real)
                    ELSE 0::real
                END
            ) OVER (
                PARTITION BY
                    m_1.league_id,
                    m_1.season_year,
                    m_1.week
            ) > 0::real AS has_def_actual_points
        FROM
            vffl.matchup_rosters mr
            JOIN vffl.matchups m_1 ON mr.matchup_id = m_1.id
        WHERE
            mr.slot_position NOT IN ('BE', 'Bench', 'IR', '20', '21')
    ),
    player_stats AS (
        SELECT
            raw_player_stats.*,
            row_number() OVER (
                PARTITION BY
                    raw_player_stats.league_id,
                    raw_player_stats.season_year,
                    raw_player_stats.week
                ORDER BY
                    (
                        CASE
                            WHEN raw_player_stats.has_actual_points THEN COALESCE(raw_player_stats.actual_fpts, 0::real)
                            ELSE COALESCE(raw_player_stats.proj_fpts, 0::real)
                        END
                    ) DESC,
                    COALESCE(raw_player_stats.proj_fpts, 0::real) DESC
            ) AS rn_goat,
            row_number() OVER (
                PARTITION BY
                    raw_player_stats.league_id,
                    raw_player_stats.season_year,
                    raw_player_stats.week
                ORDER BY
                    (
                        CASE
                            WHEN raw_player_stats.slot_position = 'D/ST' THEN
                                CASE
                                    WHEN raw_player_stats.has_def_actual_points THEN COALESCE(raw_player_stats.actual_fpts, '-999'::real)
                                    ELSE COALESCE(raw_player_stats.proj_fpts, '-999'::real)
                                END
                            ELSE '-999'::real
                        END
                    ) DESC,
                    COALESCE(raw_player_stats.proj_fpts, 0::real) DESC
            ) AS rn_defense
        FROM
            raw_player_stats
    ),
    award_winners AS (
        SELECT
            team_awards.league_id,
            team_awards.season_year,
            team_awards.week,
            'Head of the Table' AS award,
            'Highest Scoring Team' AS definition,
            team_awards.manager_id,
            NULL::integer AS player_id,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.actual_fpts
                ELSE team_awards.proj_fpts
            END AS value,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.proj_fpts::character varying
                ELSE 'Projected'::character varying
            END AS supplemental
        FROM
            team_awards
        WHERE
            team_awards.rn_head_of_table = 1
        UNION ALL
        SELECT
            team_awards.league_id,
            team_awards.season_year,
            team_awards.week,
            'Overachiever',
            'Highest Margin to Projection',
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.manager_id
                ELSE NULL::integer
            END AS manager_id,
            NULL::integer,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.actual_fpts - team_awards.proj_fpts
                ELSE NULL::real
            END AS value,
            CASE
                WHEN team_awards.has_actual_points THEN (team_awards.actual_fpts || ' - ') || team_awards.proj_fpts
                ELSE NULL::character varying
            END AS supplemental
        FROM
            team_awards
        WHERE
            team_awards.rn_overachiever = 1
        UNION ALL
        SELECT
            team_awards.league_id,
            team_awards.season_year,
            team_awards.week,
            'Body Bag',
            'Highest Margin of Victory',
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.manager_id
                ELSE NULL::integer
            END AS manager_id,
            NULL::integer,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.margin
                ELSE NULL::real
            END AS value,
            CASE
                WHEN team_awards.has_actual_points THEN (team_awards.actual_fpts || ' - ') || team_awards.opp_fpts
                ELSE NULL::character varying
            END AS supplemental
        FROM
            team_awards
        WHERE
            team_awards.rn_body_bag = 1
        UNION ALL
        SELECT
            team_awards.league_id,
            team_awards.season_year,
            team_awards.week,
            'Tough Luck',
            'Highest Score for a Losing Team',
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.manager_id
                ELSE NULL::integer
            END AS manager_id,
            NULL::integer,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.actual_fpts
                ELSE NULL::real
            END AS value,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.proj_fpts::character varying
                ELSE NULL::character varying
            END AS proj_fpts
        FROM
            team_awards
        WHERE
            team_awards.rn_tough_luck = 1
        UNION ALL
        SELECT
            team_awards.league_id,
            team_awards.season_year,
            team_awards.week,
            'Heartbreak Kid',
            'Lowest Margin of Victory',
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.manager_id
                ELSE NULL::integer
            END AS manager_id,
            NULL::integer,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.margin
                ELSE NULL::real
            END AS value,
            CASE
                WHEN team_awards.has_actual_points THEN (team_awards.actual_fpts || ' - ') || team_awards.opp_fpts
                ELSE NULL::character varying
            END AS supplemental
        FROM
            team_awards
        WHERE
            team_awards.rn_heartbreak_kid = 1
        UNION ALL
        SELECT
            team_awards.league_id,
            team_awards.season_year,
            team_awards.week,
            'Any Given Sunday',
            'Lowest Score for a Winning Team',
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.manager_id
                ELSE NULL::integer
            END AS manager_id,
            NULL::integer,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.actual_fpts
                ELSE NULL::real
            END AS value,
            CASE
                WHEN team_awards.has_actual_points THEN team_awards.proj_fpts::character varying
                ELSE NULL::character varying
            END AS proj_fpts
        FROM
            team_awards
        WHERE
            team_awards.rn_any_given_sunday = 1
        UNION ALL
        SELECT
            team_awards.league_id,
            team_awards.season_year,
            team_awards.week,
            'Armchair Architect',
            'Most Efficient Lineup',
            CASE
                WHEN team_awards.has_actual_points AND COALESCE(team_awards.wk_opt_fpts, 0::real) > 0::real THEN team_awards.manager_id
                ELSE NULL::integer
            END AS manager_id,
            NULL::integer,
            CASE
                WHEN team_awards.has_actual_points AND COALESCE(team_awards.wk_opt_fpts, 0::real) > 0::real THEN round(
                    (
                        team_awards.actual_fpts / NULLIF(team_awards.wk_opt_fpts, 0)
                    )::numeric,
                    3
                )::real
                ELSE NULL::real
            END AS round,
            CASE
                WHEN team_awards.has_actual_points AND COALESCE(team_awards.wk_opt_fpts, 0::real) > 0::real THEN (team_awards.actual_fpts || ' / ') || team_awards.wk_opt_fpts
                ELSE NULL::character varying
            END AS supplemental
        FROM
            team_awards
        WHERE
            team_awards.rn_armchair_architect = 1
        UNION ALL
        SELECT
            player_stats.league_id,
            player_stats.season_year,
            player_stats.week,
            'The GOAT',
            'Highest Scoring Player',
            player_stats.manager_id,
            player_stats.player_id,
            CASE
                WHEN player_stats.has_actual_points THEN player_stats.actual_fpts
                ELSE player_stats.proj_fpts
            END AS value,
            CASE
                WHEN player_stats.has_actual_points THEN player_stats.proj_fpts::character varying
                ELSE 'Projected'::character varying
            END AS proj_fpts
        FROM
            player_stats
        WHERE
            player_stats.rn_goat = 1
        UNION ALL
        SELECT
            player_stats.league_id,
            player_stats.season_year,
            player_stats.week,
            'You Shall Not Pass',
            'Highest Scoring Defense',
            player_stats.manager_id,
            player_stats.player_id,
            CASE
                WHEN player_stats.has_def_actual_points THEN player_stats.actual_fpts
                ELSE player_stats.proj_fpts
            END AS value,
            CASE
                WHEN player_stats.has_def_actual_points THEN player_stats.proj_fpts::character varying
                ELSE 'Projected'::character varying
            END AS proj_fpts
        FROM
            player_stats
        WHERE
            player_stats.rn_defense = 1
    )
SELECT
    aw.season_year,
    aw.week,
    l.name AS league_name,
    CASE
        WHEN m.id IS NOT NULL THEN (m.first_name || ' ') || "left" (m.last_name, 1)
        ELSE NULL::text
    END AS manager_name,
    COALESCE(t.team_name, 'TBD'::character varying(255))::character varying(255) AS team_name,
    p.name AS player_name,
    aw.award,
    aw.definition,
    aw.value,
    aw.supplemental
FROM
    award_winners aw
    JOIN vffl.leagues l ON aw.league_id = l.league_id
    AND aw.season_year = l.season_year
    LEFT JOIN vffl.managers m ON aw.manager_id = m.id
    LEFT JOIN vffl.teams t ON aw.manager_id = t.manager_id
    AND aw.league_id = t.league_id
    AND aw.season_year = t.season_year
    LEFT JOIN vffl.players p ON aw.player_id = p.id;
