WITH
    team_games AS (
        SELECT
            matchups.season_year,
            matchups.league_id,
            matchups.week,
            matchups.home_manager_id AS manager_id,
            matchups.home_score AS pf,
            matchups.away_score AS pa,
            CASE
                WHEN matchups.home_score > matchups.away_score THEN 1
                ELSE 0
            END AS wk_wins,
            CASE
                WHEN matchups.home_score < matchups.away_score THEN 1
                ELSE 0
            END AS wk_losses,
            CASE
                WHEN matchups.home_score = matchups.away_score THEN 1
                ELSE 0
            END AS wk_ties
        FROM
            vffl.matchups
        WHERE
            matchups.home_score IS NOT NULL
        UNION ALL
        SELECT
            matchups.season_year,
            matchups.league_id,
            matchups.week,
            matchups.away_manager_id AS manager_id,
            matchups.away_score AS pf,
            matchups.home_score AS pa,
            CASE
                WHEN matchups.away_score > matchups.home_score THEN 1
                ELSE 0
            END AS wk_wins,
            CASE
                WHEN matchups.away_score < matchups.home_score THEN 1
                ELSE 0
            END AS wk_losses,
            CASE
                WHEN matchups.away_score = matchups.home_score THEN 1
                ELSE 0
            END AS wk_ties
        FROM
            vffl.matchups
        WHERE
            matchups.away_score IS NOT NULL
            AND matchups.away_manager_id IS NOT NULL
    ),
    cumulative_outcomes AS (
        SELECT
            team_games.season_year,
            team_games.league_id,
            team_games.week,
            team_games.manager_id,
            sum(team_games.wk_wins) OVER (
                PARTITION BY
                    team_games.season_year,
                    team_games.league_id,
                    team_games.manager_id
                ORDER BY
                    team_games.week
            ) AS wins,
            sum(team_games.wk_losses) OVER (
                PARTITION BY
                    team_games.season_year,
                    team_games.league_id,
                    team_games.manager_id
                ORDER BY
                    team_games.week
            ) AS losses,
            sum(team_games.wk_ties) OVER (
                PARTITION BY
                    team_games.season_year,
                    team_games.league_id,
                    team_games.manager_id
                ORDER BY
                    team_games.week
            ) AS ties,
            sum(team_games.pf) OVER (
                PARTITION BY
                    team_games.season_year,
                    team_games.league_id,
                    team_games.manager_id
                ORDER BY
                    team_games.week
            ) AS points_for,
            sum(team_games.pa) OVER (
                PARTITION BY
                    team_games.season_year,
                    team_games.league_id,
                    team_games.manager_id
                ORDER BY
                    team_games.week
            ) AS points_against
        FROM
            team_games
    ),
    ranked_standings AS (
        SELECT
            cumulative_outcomes.season_year,
            cumulative_outcomes.league_id,
            cumulative_outcomes.week,
            cumulative_outcomes.manager_id,
            cumulative_outcomes.wins,
            cumulative_outcomes.losses,
            cumulative_outcomes.ties,
            round(
                (
                    cumulative_outcomes.wins::numeric + cumulative_outcomes.ties::numeric * 0.5
                ) / NULLIF(
                    cumulative_outcomes.wins + cumulative_outcomes.losses + cumulative_outcomes.ties,
                    0
                )::numeric,
                3
            )::real AS win_pct,
            cumulative_outcomes.points_for,
            cumulative_outcomes.points_against,
            cumulative_outcomes.points_for - cumulative_outcomes.points_against AS diff,
            round(
                (
                    (
                        cumulative_outcomes.points_for - cumulative_outcomes.points_against
                    ) / NULLIF(
                        cumulative_outcomes.wins + cumulative_outcomes.losses + cumulative_outcomes.ties,
                        0
                    )::double precision
                )::numeric,
                2
            )::real AS avg_diff,
            rank() OVER (
                PARTITION BY
                    cumulative_outcomes.season_year,
                    cumulative_outcomes.league_id,
                    cumulative_outcomes.week
                ORDER BY
                    (
                        (
                            cumulative_outcomes.wins::numeric + cumulative_outcomes.ties::numeric * 0.5
                        ) / NULLIF(
                            cumulative_outcomes.wins + cumulative_outcomes.losses + cumulative_outcomes.ties,
                            0
                        )::numeric
                    ) DESC,
                    cumulative_outcomes.points_for DESC
            ) AS standing
        FROM
            cumulative_outcomes
    ),
    baseline AS (
        SELECT
            baseline_standings.season_year,
            baseline_standings.league_id,
            0 AS week,
            baseline_standings.manager_id,
            0 AS wins,
            0 AS losses,
            0 AS ties,
            0.0::real AS win_pct,
            0.0::real AS points_for,
            0.0::real AS points_against,
            0.0::real AS diff,
            0.0::real AS avg_diff,
            baseline_standings.standing::bigint AS standing
        FROM
            vffl.baseline_standings
    ),
    combined_standings AS (
        SELECT
            ranked_standings.season_year,
            ranked_standings.league_id,
            ranked_standings.week,
            ranked_standings.manager_id,
            ranked_standings.wins,
            ranked_standings.losses,
            ranked_standings.ties,
            ranked_standings.win_pct,
            ranked_standings.points_for,
            ranked_standings.points_against,
            ranked_standings.diff,
            ranked_standings.avg_diff,
            ranked_standings.standing
        FROM
            ranked_standings
        UNION ALL
        SELECT
            baseline.season_year,
            baseline.league_id,
            baseline.week,
            baseline.manager_id,
            baseline.wins,
            baseline.losses,
            baseline.ties,
            baseline.win_pct,
            baseline.points_for,
            baseline.points_against,
            baseline.diff,
            baseline.avg_diff,
            baseline.standing
        FROM
            baseline
    )
SELECT
    cs.season_year,
    cs.league_id,
    cs.week,
    cs.standing::integer AS standing,
    cs.manager_id,
    cs.wins::integer AS wins,
    cs.losses::integer AS losses,
    cs.ties::integer AS ties,
    cs.win_pct,
    cs.points_for,
    cs.points_against,
    cs.diff,
    cs.avg_diff,
    (
        lag (cs.standing) OVER (
            PARTITION BY
                cs.season_year,
                cs.league_id,
                cs.manager_id
            ORDER BY
                cs.week
        ) - cs.standing
    )::integer AS standing_diff,
    l.name AS league_name,
    (m.first_name || ' ') || "left" (m.last_name, 1) AS manager_name,
    t.team_name
FROM
    combined_standings cs
    JOIN vffl.leagues l ON cs.league_id = l.league_id
    JOIN vffl.managers m ON cs.manager_id = m.id
    LEFT JOIN vffl.teams t ON cs.manager_id = t.manager_id
    AND cs.league_id = t.league_id
    AND cs.season_year = t.season_year;
