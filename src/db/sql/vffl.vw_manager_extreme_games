WITH
    league_lookup AS (
        SELECT DISTINCT
            leagues.league_id,
            leagues.name AS league_name
        FROM
            vffl.leagues
    ),
    h2h_games AS (
        SELECT
            m.season_year,
            m.league_id,
            m.week,
            m.matchup_type,
            m.home_manager_id AS manager_id,
            m.away_manager_id AS opponent_id,
            m.home_score AS points_for,
            m.away_score AS points_against,
            m.home_score - m.away_score AS margin
        FROM
            vffl.matchups m
        WHERE
            m.week > 0
            AND m.home_manager_id IS NOT NULL
            AND m.away_manager_id IS NOT NULL
            AND m.home_score IS NOT NULL
            AND m.away_score IS NOT NULL
        UNION ALL
        SELECT
            m.season_year,
            m.league_id,
            m.week,
            m.matchup_type,
            m.away_manager_id AS manager_id,
            m.home_manager_id AS opponent_id,
            m.away_score AS points_for,
            m.home_score AS points_against,
            m.away_score - m.home_score AS margin
        FROM
            vffl.matchups m
        WHERE
            m.week > 0
            AND m.home_manager_id IS NOT NULL
            AND m.away_manager_id IS NOT NULL
            AND m.home_score IS NOT NULL
            AND m.away_score IS NOT NULL
    ),
    ranked_wins AS (
        SELECT
            g.manager_id,
            'BIGGEST_WIN'::text AS category,
            row_number() OVER (
                PARTITION BY
                    g.manager_id
                ORDER BY
                    g.margin DESC,
                    g.points_for DESC,
                    g.season_year DESC,
                    g.week DESC
            )::integer AS rank,
            g.season_year,
            g.week,
            g.league_id,
            g.matchup_type,
            g.opponent_id,
            g.points_for,
            g.points_against,
            g.margin
        FROM
            h2h_games g
        WHERE
            g.margin > 0::real
    ),
    ranked_losses AS (
        SELECT
            g.manager_id,
            'BIGGEST_LOSS'::text AS category,
            row_number() OVER (
                PARTITION BY
                    g.manager_id
                ORDER BY
                    g.margin ASC,
                    g.points_for ASC,
                    g.season_year DESC,
                    g.week DESC
            )::integer AS rank,
            g.season_year,
            g.week,
            g.league_id,
            g.matchup_type,
            g.opponent_id,
            g.points_for,
            g.points_against,
            g.margin
        FROM
            h2h_games g
        WHERE
            g.margin < 0::real
    ),
    starter_performances AS (
        SELECT
            mr.manager_id,
            ('TOP_' || replace(p."position", '/', ''))::text AS category,
            row_number() OVER (
                PARTITION BY
                    mr.manager_id,
                    p."position"
                ORDER BY
                    mr.actual_fpts DESC,
                    COALESCE(mr.proj_fpts, 0::real) DESC,
                    m.season_year DESC,
                    m.week DESC,
                    mr.id DESC
            )::integer AS rank,
            m.season_year,
            m.week,
            m.league_id,
            m.matchup_type,
            CASE
                WHEN mr.manager_id = m.home_manager_id THEN m.away_manager_id
                ELSE m.home_manager_id
            END AS opponent_id,
            CASE
                WHEN mr.manager_id = m.home_manager_id THEN m.home_score
                ELSE m.away_score
            END AS points_for,
            CASE
                WHEN mr.manager_id = m.home_manager_id THEN m.away_score
                ELSE m.home_score
            END AS points_against,
            CASE
                WHEN mr.manager_id = m.home_manager_id THEN m.home_score - m.away_score
                ELSE m.away_score - m.home_score
            END AS margin,
            mr.player_id,
            p.name AS player_name,
            p."position" AS player_position,
            mr.slot_position,
            n.abbrev AS nfl_team,
            mr.actual_fpts AS player_fpts,
            mr.proj_fpts AS player_proj_fpts,
            mr.actual_fpts - mr.proj_fpts AS player_margin
        FROM
            vffl.matchup_rosters mr
            JOIN vffl.matchups m ON mr.matchup_id = m.id
            JOIN vffl.players p ON mr.player_id = p.id
            LEFT JOIN vffl.nfl n ON p.nfl_id = n.id
        WHERE
            m.week > 0
            AND m.home_manager_id IS NOT NULL
            AND m.away_manager_id IS NOT NULL
            AND m.home_score IS NOT NULL
            AND m.away_score IS NOT NULL
            AND mr.manager_id IN (m.home_manager_id, m.away_manager_id)
            AND mr.slot_position NOT IN ('BE', 'Bench', 'IR', '20', '21')
            AND p."position" IN ('QB', 'RB', 'WR', 'TE', 'K', 'D/ST')
            AND mr.actual_fpts IS NOT NULL
    ),
    combined_extremes AS (
        SELECT
            rw.manager_id,
            rw.category,
            rw.rank,
            rw.season_year,
            rw.week,
            rw.league_id,
            rw.matchup_type,
            rw.opponent_id,
            rw.points_for,
            rw.points_against,
            rw.margin,
            NULL::integer AS player_id,
            NULL::varchar(255) AS player_name,
            NULL::varchar(10) AS player_position,
            NULL::varchar(10) AS slot_position,
            NULL::varchar(10) AS nfl_team,
            NULL::real AS player_fpts,
            NULL::real AS player_proj_fpts,
            NULL::real AS player_margin
        FROM
            ranked_wins rw
        WHERE
            rw.rank <= 5
        UNION ALL
        SELECT
            rl.manager_id,
            rl.category,
            rl.rank,
            rl.season_year,
            rl.week,
            rl.league_id,
            rl.matchup_type,
            rl.opponent_id,
            rl.points_for,
            rl.points_against,
            rl.margin,
            NULL::integer AS player_id,
            NULL::varchar(255) AS player_name,
            NULL::varchar(10) AS player_position,
            NULL::varchar(10) AS slot_position,
            NULL::varchar(10) AS nfl_team,
            NULL::real AS player_fpts,
            NULL::real AS player_proj_fpts,
            NULL::real AS player_margin
        FROM
            ranked_losses rl
        WHERE
            rl.rank <= 5
        UNION ALL
        SELECT
            sp.manager_id,
            sp.category,
            sp.rank,
            sp.season_year,
            sp.week,
            sp.league_id,
            sp.matchup_type,
            sp.opponent_id,
            sp.points_for,
            sp.points_against,
            sp.margin,
            sp.player_id,
            sp.player_name,
            sp.player_position,
            sp.slot_position,
            sp.nfl_team,
            sp.player_fpts,
            sp.player_proj_fpts,
            sp.player_margin
        FROM
            starter_performances sp
        WHERE
            sp.rank <= 5
    )
SELECT
    ce.manager_id,
    (mgr.first_name || ' ') || "left" (mgr.last_name, 1) AS manager_name,
    ce.category,
    ce.rank,
    ce.season_year,
    ce.week,
    ll.league_name,
    ce.matchup_type,
    t.team_name,
    t.logo_url,
    ce.opponent_id,
    (opp.first_name || ' ') || "left" (opp.last_name, 1) AS opponent_name,
    ot.team_name AS opponent_team_name,
    ot.logo_url AS opponent_logo_url,
    round(ce.points_for::numeric, 2)::real AS points_for,
    round(ce.points_against::numeric, 2)::real AS points_against,
    round(ce.margin::numeric, 2)::real AS margin,
    ce.player_id,
    ce.player_name,
    ce.player_position,
    ce.slot_position,
    ce.nfl_team,
    round(ce.player_fpts::numeric, 2)::real AS player_fpts,
    round(ce.player_proj_fpts::numeric, 2)::real AS player_proj_fpts,
    round(ce.player_margin::numeric, 2)::real AS player_margin
FROM
    combined_extremes ce
    JOIN vffl.managers mgr ON ce.manager_id = mgr.id
    JOIN vffl.managers opp ON ce.opponent_id = opp.id
    JOIN league_lookup ll ON ce.league_id = ll.league_id
    LEFT JOIN vffl.teams t ON ce.manager_id = t.manager_id
    AND ce.league_id = t.league_id
    AND ce.season_year = t.season_year
    LEFT JOIN vffl.teams ot ON ce.opponent_id = ot.manager_id
    AND ce.league_id = ot.league_id
    AND ce.season_year = ot.season_year;
