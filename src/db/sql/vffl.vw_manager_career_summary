FROM
    vffl.managers m
    JOIN vffl.vw_manager_season_history sh ON m.id = sh.manager_id
    LEFT JOIN season_ppg sp ON m.id = sp.manager_id
    AND sh.season_year = sp.season_year
GROUP BY
    m.id,
    m.first_name,
    m.last_name,
    m.active,
    sh.season_year,
    sp.avg_ppg;
